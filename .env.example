# Пример конфигурации для docker compose. `make env` создаст .env со случайными секретами.
# Полный список настроек — в README, раздел «Настройки».

# --- обязательные -----------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Ключ первого проекта: создаётся на пустой базе. Формат: rl_live_ + 32 символа.
BOOTSTRAP_KEY=rl_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- upstream ---------------------------------------------------------------
UPSTREAM_URL=https://api.telegram.org

# --- сеть -------------------------------------------------------------------
LISTEN_PORT=8080

# --- лимиты и статистика ----------------------------------------------------
ENFORCE_LIMITS=true
STATS_ENABLED=true

# --- наблюдаемость ----------------------------------------------------------
LOG_LEVEL=INFO
# json или text
LOG_FORMAT=json
NODE_NAME=edge-1
